
<view class="splash" a:if="{{ isSplash }}">
  <image src="https://dog.ceo/img/dog-api-logo.svg" />
  <ant-typography
    className="typography"
    fontWeight="bold"
    icon=""
    style="color: #1677ff"
    data-type="copy"
    data-text=""
  >
  Street Doggos
  </ant-typography>
  <ant-loading type="spin" color="#000" />
</view>

<ant-container
    title="Save a street dog, today!"
    className="container"
  >


  <view class="doggo-section">
    <view class="loader" a:if="{{ isLoading }}">
      <ant-loading type="spin" color="#1677ff" size="large" />
    </view>

    <view style="width:.5rem">
      <previous-image-btn onClickMe="previousImage" 
    a:if="{{ prevImage.length >= 2 }}"
    />
    </view>
    
    <image class="doggo-img" mode="scaleToFill" src={{ doggos_pic }} alt="picture of a dog"/>
    
    <view style="width:.5rem">
      <next-image-btn onClickMe="nextImage" 
      isDisabled="{{ prevImage.length >= 12 }}"  
      /> 
    </view>   
  </view>

  <view style="text-align:center">
    <count-down></count-down>
  </view>

  <view>
    <ant-progress
    percent="{{percent2}}"
    strokeWidth="15"
    style="margin-top: 40rpx;"
  ></ant-progress>
  </view>

  <view>
    <ant-button
      inline
      onTap="handleIncrease"
    >
      50
    </ant-button>
    <ant-button
      inline
      onTap="handleIncrease"
    >
      100
    </ant-button>
    <ant-button
      inline
      onTap="handleIncrease"
    >
      200
    </ant-button>
    <ant-button
      inline
      onTap="handleIncrease"
    >
      500
    </ant-button>
    <ant-button
      inline
      onTap="handleIncrease"
    >
      1000
    </ant-button>
  </view>

  

  <view>
    <ant-button
      inline
      onTap="handleIncrease"
    >
      Increase
    </ant-button>
  </view>
  
</ant-container>


  

