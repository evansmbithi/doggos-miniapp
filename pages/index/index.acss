.splash{
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 100;
  margin: 0;
  background-color: #fff;
  padding: 0;
}

.splash image{
  width: 150px;
  margin: 0;
  padding: 0;
}

.typography {
  margin-bottom: 1rem;
}

.container{
  position: relative;
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loader{
  position: absolute;
  top: 40vh;
  left: 40%;
}

.doggo-section{
  display: flex;
  align-items: center;
}

.doggo-img{
  border-radius: .5rem;
  margin: .1rem;
}