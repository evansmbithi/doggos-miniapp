.container{
  position: relative;
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loader{
  position: absolute;
  top: 40vh;
  left: 40%;
}

.doggo-section{
  display: flex;
  align-items: center;
}

.doggo-img{
  border-radius: .5rem;
  margin: .1rem;
}