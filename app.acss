*{
  font-size: 16px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
}

page {
  flex: 1;
  display: flex;
  background: #f7f7f7;
}

.btn-outline{
  color: #000;
  background: none;
  border-radius: 50%;  
  font-size: .5rem;
}

.btn-outline:active{
  background: #000;
  color: #fff;
}